# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://viveksrivastava.dev

# AI assistant (pick one; Anthropic is preferred). Without a key the assistant
# still answers using local retrieval over your profile, just without an LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Contact form (https://resend.com). Without a key the form falls back to mailto.
RESEND_API_KEY=
CONTACT_TO_EMAIL=vivekkumarsrivastava877@gmail.com
CONTACT_FROM_EMAIL=Portfolio <contact@viveksrivastava.dev>

# Optional: raises the GitHub API rate limit from 60 to 5000 req/h
GITHUB_TOKEN=

# Optional: PostHog product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
